{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fourthfish",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "fourthfish-production",
    "database_id": "c743737f-3777-4ce8-ab70-d00f8e129b8d",
    "migrations_dir": "cloudflare/migrations"
  }],
  "ratelimits": [{
    "name": "API_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 30, "period": 60 }
  }],
  "vars": {
    "APP_ORIGIN": "https://fourthfish.lethanhphanhien005.workers.dev",
    "STORE_ENABLED": "false",
    "NOTIFICATIONS_ENABLED": "false",
    "EMAIL_FROM": "Fourthfish <orders@your-domain.vn>"
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
